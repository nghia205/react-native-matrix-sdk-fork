+/// Reject unsupported key-file headers and excessive KDF work before invoking SDK decryption.
+/// Read at most 4 KB; this examines ciphertext metadata, never plaintext session keys.
+fn is_supported_key_export_prefix(prefix: &str) -> bool {
+    const HEADER: &str = "-----BEGIN MEGOLM SESSION DATA-----";
+    const FOOTER: &str = "-----END MEGOLM SESSION DATA-----";
+    if !prefix.trim_start().starts_with(HEADER) {
+        return false;
+    }
+    let encoded: String = prefix
+        .lines()
+        .filter(|line| !line.starts_with(HEADER) && !line.starts_with(FOOTER))
+        .flat_map(str::chars)
+        .take(52)
+        .collect();
+    let Ok(decoded) = matrix_sdk_base::crypto::vodozemac::base64_decode(encoded) else {
+        return false;
+    };
+    if decoded.len() < 37 || decoded[0] != 1 {
+        return false;
+    }
+    let rounds = u32::from_be_bytes(decoded[33..37].try_into().expect("checked prefix length"));
+    (1..=2_000_000).contains(&rounds)
+}
