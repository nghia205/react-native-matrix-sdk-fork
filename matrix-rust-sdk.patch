+    /// Export the currently open crypto store without reopening SQLite or exposing its passphrase.
+    /// Wait for initialization before reading the private signing and optional backup secrets.
+    pub async fn export_secrets_bundle(&self) -> Result<SecretsBundle, matrix_sdk_base::crypto::store::SecretsBundleExportError> {
