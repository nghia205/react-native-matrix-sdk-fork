+/// Reject empty destinations and blank credentials without normalizing the SDK password bytes.
+fn validate_room_key_transfer(path: &str, passphrase: &str) -> Result<(), ClientError> {
+    if path.trim().is_empty() || passphrase.trim().is_empty() {
+        return Err(ClientError::Generic {
