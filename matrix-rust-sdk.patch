+#[cfg(all(test, feature = "unstable-msc4274"))]
+mod gallery_source_tests {
+    use std::{fs, path::PathBuf};
+
+    use ruma::events::room::message::TextMessageEventContent;
+
+    use super::{read_gallery_source, validate_gallery_sources};
+    use crate::attachment::{
+        AttachmentInfo, BaseFileInfo, GallerySourceConfig, GallerySourceItemInfo,
+        GalleryUploadSource,
+    };
+
+    fn file_item(path: PathBuf, filename: String, size: u64) -> GallerySourceItemInfo {
+        GallerySourceItemInfo {
+            source: GalleryUploadSource::File { path, filename, size },
+            content_type: mime::APPLICATION_OCTET_STREAM,
+            attachment_info: AttachmentInfo::File(BaseFileInfo::default()),
+            caption: Some(TextMessageEventContent::plain("test")),
+            thumbnail: None,
+        }
+    }
+
+    #[test]
+    fn ten_file_gallery_keeps_originals_lazy_until_each_child_is_read() {
+        let test_root = std::env::temp_dir()
+            .join(format!("matrix-gallery-lazy-{}", ruma::TransactionId::new()));
+        fs::create_dir_all(&test_root).expect("create test directory");
+        let mut config = GallerySourceConfig::new();
+        for index in 0..10 {
+            let path = test_root.join(format!("child-{index}.bin"));
+            fs::write(&path, [index as u8; 32]).expect("write gallery child");
+            config = config.add_item(file_item(path, format!("child-{index}.bin"), 32));
+        }
+
+        validate_gallery_sources(&config).expect("ten lazy sources pass preflight");
+        assert!(
+            config.items.iter().all(|item| matches!(item.source, GalleryUploadSource::File { .. }))
+        );
+
+        fs::remove_dir_all(test_root).expect("remove test directory");
+    }
+
+    #[test]
+    fn deleted_file_fails_before_gallery_queue_mutation() {
+        let path = std::env::temp_dir()
+            .join(format!("matrix-gallery-deleted-{}.bin", ruma::TransactionId::new()));
+        fs::write(&path, [7u8; 16]).expect("write gallery child");
+        let source = GalleryUploadSource::File {
+            path: path.clone(),
+            filename: "deleted.bin".to_owned(),
+            size: 16,
+        };
+        fs::remove_file(path).expect("delete gallery child");
+
+        assert!(read_gallery_source(source).is_err());
+    }
+
+    #[test]
+    fn single_child_is_not_a_gallery() {
+        let path = std::env::temp_dir()
+            .join(format!("matrix-gallery-single-{}.bin", ruma::TransactionId::new()));
+        fs::write(&path, [1u8; 4]).expect("write gallery child");
+        let mut config = GallerySourceConfig::new();
+        config = config.add_item(file_item(path.clone(), "single.bin".to_owned(), 4));
+
+        let error = validate_gallery_sources(&config).expect_err("single child must be rejected");
+        assert!(error.to_string().contains("at least two"));
+        let _ = fs::remove_file(path);
+    }
+}
