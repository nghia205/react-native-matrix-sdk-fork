+use matrix_sdk_base::crypto as bundle_crypto;
+
+mod bundle_envelope {
+    //! Password-protected, authenticated secrets-bundle envelope owned by the Mobile native host.
+    //! Input/output are bounded bytes; only ciphertext may be persisted. The versioned magic is AAD,
+    //! followed by a 32-byte salt, 12-byte nonce and AES-256-GCM ciphertext/tag. PBKDF2 cost is fixed
+    //! so imported files cannot request unbounded work.
+    use aes_gcm::{
+        aead::{Aead, Payload},
+        Aes256Gcm, KeyInit, Nonce,
+    };
+    use rand::Rng;
+    use zeroize::Zeroizing;
+
+    pub const MAX_FILE_BYTES: usize = 1024 * 1024;
+    const MAGIC: &[u8] = b"MATRIX_SECRETS_BUNDLE\x01";
+    const ROUNDS: u32 = 600_000;
+    const OVERHEAD: usize = MAGIC.len() + 32 + 12 + 16;
+
+    /// Deliberately carries no underlying crypto error, payload, password or private path.
+    #[derive(Debug)]
+    pub struct InvalidBundle;
+
+    /// Encrypt exact passphrase bytes with fresh salt/nonce; callers must never persist `plaintext`.
+    pub fn encrypt(plaintext: &[u8], passphrase: &str) -> Result<Vec<u8>, InvalidBundle> {
+        if plaintext.len() > MAX_FILE_BYTES - OVERHEAD
+            || passphrase.len() < 12
+            || passphrase.len() > 1024
+            || passphrase.trim().is_empty()
+        {
+            return Err(InvalidBundle);
+        }
+        let mut salt = [0u8; 32];
+        let mut nonce = [0u8; 12];
+        let mut rng = rand::rng();
+        rng.fill_bytes(&mut salt);
+        rng.fill_bytes(&mut nonce);
+        let key = derive_key(passphrase, &salt);
+        let cipher = Aes256Gcm::new_from_slice(key.as_ref()).map_err(|_| InvalidBundle)?;
+        let ciphertext = cipher
+            .encrypt(
+                Nonce::from_slice(&nonce),
+                Payload {
+                    msg: plaintext,
+                    aad: MAGIC,
+                },
+            )
+            .map_err(|_| InvalidBundle)?;
+        let mut output = Vec::with_capacity(OVERHEAD + plaintext.len());
+        output.extend_from_slice(MAGIC);
+        output.extend_from_slice(&salt);
+        output.extend_from_slice(&nonce);
+        output.extend(ciphertext);
+        Ok(output)
+    }
+
+    /// Authenticate before returning any plaintext; bounded header parsing precedes expensive KDF work.
+    pub fn decrypt(
+        ciphertext: &[u8],
+        passphrase: &str,
+    ) -> Result<Zeroizing<Vec<u8>>, InvalidBundle> {
+        if ciphertext.len() < OVERHEAD
+            || ciphertext.len() > MAX_FILE_BYTES
+            || !ciphertext.starts_with(MAGIC)
+            || passphrase.trim().is_empty()
+            || passphrase.len() > 1024
+        {
+            return Err(InvalidBundle);
+        }
+        let salt_end = MAGIC.len() + 32;
+        let nonce_end = salt_end + 12;
+        let key = derive_key(passphrase, &ciphertext[MAGIC.len()..salt_end]);
+        let cipher = Aes256Gcm::new_from_slice(key.as_ref()).map_err(|_| InvalidBundle)?;
+        cipher
+            .decrypt(
+                Nonce::from_slice(&ciphertext[salt_end..nonce_end]),
+                Payload {
+                    msg: &ciphertext[nonce_end..],
+                    aad: MAGIC,
+                },
+            )
+            .map(Zeroizing::new)
+            .map_err(|_| InvalidBundle)
+    }
+
+    /// Keep derived key bytes in zeroizing storage for every success/failure path.
+    fn derive_key(passphrase: &str, salt: &[u8]) -> Zeroizing<[u8; 32]> {
+        let mut key = Zeroizing::new([0u8; 32]);
+        pbkdf2::pbkdf2_hmac::<sha2::Sha256>(passphrase.as_bytes(), salt, ROUNDS, key.as_mut());
+        key
+    }
+
+    #[cfg(test)]
+    mod tests {
+        use super::*;
+        #[test]
+        fn authenticated_round_trip_and_tampering() {
+            let secret = b"private bundle fixture";
+            let password = " exact password ";
+            let first = encrypt(secret, password).unwrap();
+            let second = encrypt(secret, password).unwrap();
+            assert_ne!(first, second);
+            assert!(!first.windows(secret.len()).any(|window| window == secret));
+            assert_eq!(&*decrypt(&first, password).unwrap(), secret);
+            assert!(decrypt(&first, "wrong password").is_err());
+            for index in [0, MAGIC.len(), MAGIC.len() + 32, first.len() - 1] {
+                let mut altered = first.clone();
+                altered[index] ^= 1;
+                assert!(decrypt(&altered, password).is_err());
+            }
+        }
+        #[test]
+        fn rejects_unbounded_and_invalid_inputs_before_derivation() {
+            assert!(decrypt(&vec![0; MAX_FILE_BYTES + 1], "password").is_err());
+            assert!(decrypt(b"{}", "password").is_err());
+            assert!(encrypt(b"{}", "short").is_err());
+            assert!(encrypt(&vec![0; MAX_FILE_BYTES], "valid password").is_err());
+        }
+    }
