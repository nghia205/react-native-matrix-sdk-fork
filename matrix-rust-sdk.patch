+#[cfg(feature = "unstable-msc4274")]
+const MAX_GALLERY_FILE_BYTES: u64 = 10 * 1024 * 1024;
+#[cfg(feature = "unstable-msc4274")]
+const MAX_GALLERY_TOTAL_BYTES: u64 = 50 * 1024 * 1024;
+
+/// Validates lazy sources without reading originals or mutating the media/send queue stores.
+#[cfg(feature = "unstable-msc4274")]
+fn validate_gallery_sources(gallery: &GallerySourceConfig) -> Result<(), RoomSendQueueError> {
+    if gallery.len() < 2 {
+        return Err(RoomSendQueueError::InvalidGallerySource(
+            "a gallery must contain at least two children".to_owned(),
+        ));
+    }
+    if gallery.len() > 10 {
+        return Err(RoomSendQueueError::InvalidGallerySource(
+            "a gallery may contain at most 10 children".to_owned(),
+        ));
+    }
+
+    let mut total = 0u64;
+    for item in &gallery.items {
+        let declared_size = match &item.source {
+            GalleryUploadSource::Data { bytes, filename, size } => {
+                if filename.trim().is_empty() || bytes.len() as u64 != *size {
+                    return Err(RoomSendQueueError::InvalidGallerySource(
+                        "in-memory gallery source size or filename is invalid".to_owned(),
+                    ));
+                }
+                *size
+            }
+            GalleryUploadSource::File { path, filename, size } => {
+                if filename.trim().is_empty() {
+                    return Err(RoomSendQueueError::InvalidGallerySource(
+                        "gallery filename is empty".to_owned(),
+                    ));
+                }
+                let metadata = File::open(path)
+                    .and_then(|file| file.metadata())
+                    .map_err(|error| RoomSendQueueError::InvalidGallerySource(error.to_string()))?;
+                if !metadata.is_file() || metadata.len() != *size {
+                    return Err(RoomSendQueueError::InvalidGallerySource(
+                        "gallery file disappeared or changed size".to_owned(),
+                    ));
+                }
+                *size
+            }
+        };
+        if declared_size > MAX_GALLERY_FILE_BYTES {
+            return Err(RoomSendQueueError::InvalidGallerySource(
+                "gallery child exceeds the 10 MiB limit".to_owned(),
+            ));
+        }
+        total = total.checked_add(declared_size).ok_or_else(|| {
+            RoomSendQueueError::InvalidGallerySource("gallery byte total overflowed".to_owned())
+        })?;
+    }
+    if total > MAX_GALLERY_TOTAL_BYTES {
+        return Err(RoomSendQueueError::InvalidGallerySource(
+            "gallery exceeds the 50 MiB total limit".to_owned(),
+        ));
+    }
+    Ok(())
+}
+
+/// Materializes exactly one validated child using a bounded reader, then releases the file handle.
+#[cfg(feature = "unstable-msc4274")]
+fn read_gallery_source(
+    source: GalleryUploadSource,
+) -> Result<(Vec<u8>, String), RoomSendQueueError> {
+    match source {
+        GalleryUploadSource::Data { bytes, filename, size } => {
+            if bytes.len() as u64 != size {
+                return Err(RoomSendQueueError::InvalidGallerySource(
+                    "in-memory gallery source changed size".to_owned(),
+                ));
+            }
+            Ok((bytes, filename))
+        }
+        GalleryUploadSource::File { path, filename, size } => {
+            let file = File::open(path)
+                .map_err(|error| RoomSendQueueError::InvalidGallerySource(error.to_string()))?;
+            let metadata = file
+                .metadata()
+                .map_err(|error| RoomSendQueueError::InvalidGallerySource(error.to_string()))?;
+            if !metadata.is_file() || metadata.len() != size || size > MAX_GALLERY_FILE_BYTES {
+                return Err(RoomSendQueueError::InvalidGallerySource(
+                    "gallery file disappeared, changed size, or exceeded its limit".to_owned(),
+                ));
+            }
+            let mut bytes = Vec::with_capacity(size as usize);
+            BufReader::new(file)
+                .take(size.saturating_add(1))
+                .read_to_end(&mut bytes)
+                .map_err(|error| RoomSendQueueError::InvalidGallerySource(error.to_string()))?;
+            if bytes.len() as u64 != size {
+                return Err(RoomSendQueueError::InvalidGallerySource(
+                    "gallery file changed while it was being read".to_owned(),
+                ));
+            }
+            Ok((bytes, filename))
+        }
+    }
+}
