+
+    /// Sets reply metadata for the parent event.
+    pub fn reply(mut self, reply: Option<Reply>) -> Self {
+        self.reply = reply;
+        self
+    }
+
+    /// Returns the ordered child count.
+    pub fn len(&self) -> usize {
+        self.items.len()
+    }
