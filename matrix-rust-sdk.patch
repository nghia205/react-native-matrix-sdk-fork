+mod bundle_validation {
+    //! Mobile native bundle validation.
+    //! Network failures never imply an absent backup. Import/export require the current account's
+    //! three server-published signing keys and both the backup key and version to match before mutation.
+    use super::bundle_crypto;
+    use bundle_crypto::types::{BackupSecrets, RoomKeyBackupInfo, SecretsBundle};
+    use matrix_sdk::{
+        ruma::{
+            api::{
+                client::{backup::get_latest_backup_info, keys::get_keys},
+                error::ErrorKind,
+            },
+            OwnedUserId,
+        },
+        Client,
+    };
+    use serde::{Deserialize, Serialize};
+
+    /// Authenticated native payload. Private key fields are zeroized by the SDK on drop.
+    #[derive(Serialize, Deserialize)]
+    pub struct OwnedBundle {
+        pub user_id: OwnedUserId,
+        pub bundle: SecretsBundle,
+    }
+    #[derive(Clone, Copy, Debug, PartialEq, Eq)]
+    pub enum BundleState {
+        WithoutBackup,
+        UnusedBackup,
+        Complete,
+    }
+
+    /// Distinguish absent backup (404) from untrustworthy metadata or failed server requests.
+    pub async fn backup_info(client: &Client) -> Result<Option<(String, RoomKeyBackupInfo)>, ()> {
+        match client
+            .send(get_latest_backup_info::v3::Request::new())
+            .await
+        {
+            Ok(response) => Ok(Some((
+                response.version,
+                response.algorithm.deserialize_as().map_err(|_| ())?,
+            ))),
+            Err(error) if error.client_api_error_kind() == Some(&ErrorKind::NotFound) => Ok(None),
+            Err(_) => Err(()),
+        }
+    }
+
+    /// Compare both the advertised version and derived public key; obsolete backup keys are not complete.
+    pub fn detect(
+        bundle: &SecretsBundle,
+        info: Option<&(String, RoomKeyBackupInfo)>,
+    ) -> BundleState {
+        match (&bundle.backup, info) {
+            (None, _) => BundleState::WithoutBackup,
+            (Some(BackupSecrets::MegolmBackupV1Curve25519AesSha2(secret)), Some((version, info)))
+                if &secret.backup_version == version && secret.key.backup_key_matches(info) =>
+            {
+                BundleState::Complete
+            }
+            _ => BundleState::UnusedBackup,
+        }
+    }
+
+    /// Query authoritative public keys before the SDK's unchecked bundle import can replace local identity.
+    /// A same-account but obsolete signing identity must never overwrite keys from a later identity reset.
+    pub async fn validate_identity(client: &Client, bundle: &SecretsBundle) -> Result<(), ()> {
+        let user = client.user_id().ok_or(())?;
+        let mut request = get_keys::v3::Request::new();
+        request.device_keys.insert(user.to_owned(), Vec::new());
+        let response = client.send(request).await.map_err(|_| ())?;
+        let seeds = [
+            &bundle.cross_signing.master_key,
+            &bundle.cross_signing.self_signing_key,
+            &bundle.cross_signing.user_signing_key,
+        ];
+        let keys = [
+            &response.master_keys,
+            &response.self_signing_keys,
+            &response.user_signing_keys,
+        ];
+        for ((seed, keys), usage) in
+            seeds
+                .into_iter()
+                .zip(keys)
+                .zip(["master", "self_signing", "user_signing"])
+        {
+            let expected = keys.get(user).ok_or(())?.deserialize().map_err(|_| ())?;
+            if !matches_signing_key(seed, &expected, user, usage) {
+                return Err(());
+            }
+        }
+        Ok(())
+    }
+
+    /// Compare a seed's derived public key and owner without accepting a foreign or malformed identity.
+    fn matches_signing_key(
+        seed: &str,
+        expected: &matrix_sdk::ruma::encryption::CrossSigningKey,
+        user: &matrix_sdk::ruma::UserId,
+        usage: &str,
+    ) -> bool {
+        let Ok(secret) = bundle_crypto::vodozemac::Ed25519SecretKey::from_base64(seed) else {
+            return false;
+        };
+        let public = secret.public_key().to_base64();
+        expected.user_id == user
+            && expected.keys.len() == 1
+            && expected.usage.iter().any(|value| value.as_str() == usage)
+            && expected.keys.iter().next().is_some_and(|(id, value)| {
+                id.as_str() == format!("ed25519:{public}") && value == &public
+            })
+    }
+
+    #[cfg(test)]
+    mod tests {
+        use super::*;
+        use bundle_crypto::{
+            store::types::BackupDecryptionKey,
+            types::{CrossSigningSecrets, MegolmBackupV1Curve25519AesSha2Secrets},
+        };
+        #[test]
+        fn rejects_wrong_account_old_signing_keys_and_malformed_seeds() {
+            let seed = "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA";
+            let public = bundle_crypto::vodozemac::Ed25519SecretKey::from_base64(seed)
+                .unwrap()
+                .public_key()
+                .to_base64();
+            let expected: matrix_sdk::ruma::encryption::CrossSigningKey = serde_json::from_value(serde_json::json!({
+                "user_id": "@owner:example.org", "usage": ["master"], "keys": { format!("ed25519:{public}"): public }
+            })).unwrap();
+            assert!(matches_signing_key(
+                seed,
+                &expected,
+                matrix_sdk::ruma::user_id!("@owner:example.org"),
+                "master"
+            ));
+            assert!(!matches_signing_key(
+                seed,
+                &expected,
+                matrix_sdk::ruma::user_id!("@other:example.org"),
+                "master"
+            ));
+            assert!(!matches_signing_key(
+                "AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE",
+                &expected,
+                matrix_sdk::ruma::user_id!("@owner:example.org"),
+                "master"
+            ));
+            assert!(!matches_signing_key(
+                "invalid",
+                &expected,
+                matrix_sdk::ruma::user_id!("@owner:example.org"),
+                "master"
+            ));
+        }
+        #[test]
+        fn checks_missing_backup_version_and_public_key_independently() {
+            let key = BackupDecryptionKey::new();
+            let info = key.to_backup_info();
+            let mut bundle = SecretsBundle {
+                cross_signing: CrossSigningSecrets {
+                    master_key: String::new(),
+                    self_signing_key: String::new(),
+                    user_signing_key: String::new(),
+                },
+                backup: None,
+            };
+            assert_eq!(detect(&bundle, None), BundleState::WithoutBackup);
+            bundle.backup = Some(BackupSecrets::MegolmBackupV1Curve25519AesSha2(
+                MegolmBackupV1Curve25519AesSha2Secrets {
+                    key: key.clone(),
+                    backup_version: "1".into(),
+                },
+            ));
+            assert_eq!(detect(&bundle, None), BundleState::UnusedBackup);
+            assert_eq!(
+                detect(&bundle, Some(&("1".into(), info.clone()))),
+                BundleState::Complete
+            );
+            assert_eq!(
+                detect(&bundle, Some(&("2".into(), info))),
+                BundleState::UnusedBackup
+            );
+            assert_eq!(
+                detect(
+                    &bundle,
+                    Some(&("1".into(), BackupDecryptionKey::new().to_backup_info()))
+                ),
+                BundleState::UnusedBackup
+            );
+        }
+    }
+}
+
+use bundle_validation::OwnedBundle as TransferSecretsBundle;
+/// Check both backup version and key using the cross-platform native policy.
+fn detect_bundle_version(bundle: &matrix_sdk_base::crypto::types::SecretsBundle, info: Option<&(String, RoomKeyBackupInfo)>) -> DetectedSecretsBundle {
+    match bundle_validation::detect(bundle, info) {
+        bundle_validation::BundleState::WithoutBackup => DetectedSecretsBundle::WithoutBackup,
+        bundle_validation::BundleState::UnusedBackup => DetectedSecretsBundle::UnusedBackup,
+        bundle_validation::BundleState::Complete => DetectedSecretsBundle::Complete,
+    }
+}
+fn bundle_transfer_error(code: &str) -> ClientError {
+    ClientError::Generic { msg: format!("SECRETS_BUNDLE_{code}"), details: None }
+}
+impl Encryption {
+    /// Fetch current server metadata using the shared native validation policy.
+    async fn secrets_bundle_backup_info(&self) -> Result<Option<(String, RoomKeyBackupInfo)>, ClientError> {
+        bundle_validation::backup_info(&self._client.inner).await.map_err(|_| bundle_transfer_error("BACKUP"))
+    }
+}
